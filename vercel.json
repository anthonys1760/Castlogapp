{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/blog/template/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/blog/posts/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
